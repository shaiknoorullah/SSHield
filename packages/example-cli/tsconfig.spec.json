{
  "extends": "@sshield/config/ts/ui/spec",
  "compilerOptions": {
    "outDir": "./dist-spec",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
