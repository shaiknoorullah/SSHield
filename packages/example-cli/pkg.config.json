{
  "scripts": ["dist/**/*.js"],
  "assets": ["package.json", "dist/**/*.json", "dist/**/*.md"],
  "targets": [
    "node18-linux-x64",
    "node18-linux-arm64",
    "node18-macos-x64",
    "node18-macos-arm64",
    "node18-win-x64",
    "node18-win-arm64"
  ],
  "outputPath": "bin",
  "compress": "Brotli"
}
