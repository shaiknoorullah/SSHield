{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "sourceMap": true,
    "types": ["node", "react", "mocha", "chai"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ]
}
